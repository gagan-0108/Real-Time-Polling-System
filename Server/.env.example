# Server configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ionpoll
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ionpoll

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key

# Plan limits
PLAN_AUTH_LIMIT=5
PLAN_ANON_LIMIT=2
PLAN_RESPONSES_LIMIT=100
